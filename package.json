{
  "name": "@agent-hand/agent-question",
  "version": "0.1.0",
  "description": "AI の問いを画面に出して回答を返す機構（面と往復）を提供する Nuxt module。@nuxt/ui の部品の上で働く",
  "repository": "agent-hand/agent-question",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "style": "./dist/runtime/index.css",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "style": "./dist/runtime/index.css",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "yarn dev:prepare && nuxt dev playground --port 3300",
    "dev:build": "nuxt build playground",
    "dev:preview": "nuxt preview playground",
    "dev:prepare": "nuxt-module-build build && nuxt-module-build prepare && nuxt prepare playground",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@vueuse/core": "^14.4.0",
    "defu": "^6.1.7"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.10.0",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/ui": "^4.10.0",
    "@types/node": "^22",
    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  }
}
